              "raw": "{\n  \"symptomName\": \"High Grade Fever with Rigors\",\n  \"severity\": \"CRITICAL\",\n  \"durationDays\": 5,\n  \"description\": \"Fever spiked to 103 F, patient feeling dizzy\"\n}"
