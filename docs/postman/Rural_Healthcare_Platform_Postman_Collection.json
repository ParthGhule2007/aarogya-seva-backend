{
  "info": {
    "name": "Rural Healthcare Platform API (Port 8081)",
    "description": "Comprehensive Postman test collection for Module 1 (Facilities & PostGIS Discovery), Module 2 (Patient & Healthcare Cases), and Module 3 (Symptom Intake & Management).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "facilityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "caseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "caseNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "symptomId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Module 1 - Healthcare Facilities",
      "item": [
        {
          "name": "1.1 List All Facilities",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0 && !pm.collectionVariables.get('facilityId')) {",
                  "    pm.collectionVariables.set('facilityId', jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities"]
            }
          }
        },
        {
          "name": "1.2 Create Healthcare Facility",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('facilityId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohanlalganj Community Health Centre\",\n  \"facilityType\": \"CHC\",\n  \"latitude\": 26.6811,\n  \"longitude\": 80.9984,\n  \"addressLine1\": \"Hospital Road\",\n  \"villageTown\": \"Mohanlalganj\",\n  \"subDistrict\": \"Mohanlalganj\",\n  \"district\": \"Lucknow\",\n  \"state\": \"Uttar Pradesh\",\n  \"pincode\": \"226301\",\n  \"contactNumber\": \"+91-522-298201\",\n  \"emergencyNumber\": \"108\",\n  \"isOperational\": true,\n  \"serviceCodes\": [\n    \"GENERAL_OPD\",\n    \"EMERGENCY\",\n    \"MATERNAL_HEALTH\",\n    \"DIAGNOSTIC_LAB\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities"]
            }
          }
        },
        {
          "name": "1.3 Get Facility by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities/{{facilityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities", "{{facilityId}}"]
            }
          }
        },
        {
          "name": "1.4 PostGIS Nearby Facility Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities/nearby?latitude=26.8467&longitude=80.9462&radiusKm=30&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities", "nearby"],
              "query": [
                {
                  "key": "latitude",
                  "value": "26.8467"
                },
                {
                  "key": "longitude",
                  "value": "80.9462"
                },
                {
                  "key": "radiusKm",
                  "value": "30"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "1.5 Nearby Facilities with Service Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities/nearby?latitude=26.8467&longitude=80.9462&radiusKm=50&services=EMERGENCY,MATERNAL_HEALTH&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities", "nearby"],
              "query": [
                {
                  "key": "latitude",
                  "value": "26.8467"
                },
                {
                  "key": "longitude",
                  "value": "80.9462"
                },
                {
                  "key": "radiusKm",
                  "value": "50"
                },
                {
                  "key": "services",
                  "value": "EMERGENCY,MATERNAL_HEALTH"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "1.6 Update Facility Operational Status",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facilities/{{facilityId}}/status?operational=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facilities", "{{facilityId}}", "status"],
              "query": [
                {
                  "key": "operational",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
