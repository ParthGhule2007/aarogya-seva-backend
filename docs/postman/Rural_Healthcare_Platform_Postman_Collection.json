    {
      "name": "Module 2 - Healthcare Cases",
      "item": [
        {
          "name": "3.1 List All Cases",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0 && !pm.collectionVariables.get('caseId')) {",
                  "    pm.collectionVariables.set('caseId', jsonData.data[0].id);",
                  "    pm.collectionVariables.set('caseNumber', jsonData.data[0].caseNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases"]
            }
          }
        },
        {
          "name": "3.2 Open Consultation Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.id) pm.collectionVariables.set('caseId', jsonData.data.id);",
                  "    if (jsonData.data.caseNumber) pm.collectionVariables.set('caseNumber', jsonData.data.caseNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"intakeChannel\": \"COMMUNITY_HEALTH_WORKER\",\n  \"chiefComplaint\": \"Fever, persistent cough, and fatigue\",\n  \"notes\": \"Screened by ASHA worker during village visit\",\n  \"latitude\": 26.6811,\n  \"longitude\": 80.9984\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases"]
            }
          }
        },
        {
          "name": "3.3 Get Case Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases/{{caseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases", "{{caseId}}"]
            }
          }
        },
        {
          "name": "3.4 List Cases for Patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases/patient/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases", "patient", "{{patientId}}"]
            }
          }
        },
        {
          "name": "3.5 Advance Case Status (Pending Triage)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING_TRIAGE\",\n  \"priority\": \"HIGH\",\n  \"notes\": \"Submitted for clinical triage\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases/{{caseId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cases", "{{caseId}}", "status"]
            }
          }
        }
      ]
