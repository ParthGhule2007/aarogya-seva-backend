# ==============================================================================
# Aarogya Seva Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Backend Microservices & API Gateway
# In Vite local development (port 5173), leaving microservice URLs blank uses
# vite.config.ts reverse proxy routes (recommended to prevent CORS).
# To point to specific standalone remote or local services, uncomment and fill:
VITE_API_BASE_URL=
VITE_DOCTOR_SERVICE_URL=
VITE_CONSULTATION_SERVICE_URL=
VITE_COMMUNICATION_SERVICE_URL=
VITE_SOS_SERVICE_URL=
VITE_CHAT_SERVICE_URL=
VITE_MEDICATION_SERVICE_URL=
VITE_CALLING_SERVICE_URL=

# Video Teleconsultation
# Configurable Jitsi Meet domain (default: meet.jit.si)
VITE_JITSI_DOMAIN=meet.jit.si

# Firebase Push Notifications & Cloud Messaging
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_KEY
