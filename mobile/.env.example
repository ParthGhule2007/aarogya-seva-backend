# ==============================================================================
# Aarogya Seva Mobile (Expo) Environment Configuration
# ==============================================================================
# In Expo, variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# 
# For Development on a PHYSICAL PHONE using Expo Go:
# Set EXPO_PUBLIC_API_HOST to your computer's local Wi-Fi / LAN IP (e.g. 192.168.1.50)
# (Do NOT use localhost or 10.0.2.2 because the physical phone cannot resolve them)
# ==============================================================================

EXPO_PUBLIC_API_HOST=http://192.168.1.50

# Optional per-service overrides (Defaults to ${EXPO_PUBLIC_API_HOST}:<PORT>):
# Core Service (Port 8081): Auth, Patients, Cases, Geospatial Facilities
EXPO_PUBLIC_CORE_URL=http://192.168.1.50:8081

# SOS Emergency Service (Port 8082): Emergency broadcasts, Device FCM registration
EXPO_PUBLIC_SOS_URL=http://192.168.1.50:8082

# Consultation Service (Port 8083): Appointments, Teleconsultation workflows
EXPO_PUBLIC_CONSULTATION_URL=http://192.168.1.50:8083

# Communication Service (Port 8084): Video/Voice Sessions (Jitsi/WebRTC)
EXPO_PUBLIC_COMMUNICATION_URL=http://192.168.1.50:8084

# Chatbot Service (Port 8085): Conversational AI Triage
EXPO_PUBLIC_CHATBOT_URL=http://192.168.1.50:8085

# Doctor Service (Port 8086): Doctor Directory, Availability Status
EXPO_PUBLIC_DOCTOR_URL=http://192.168.1.50:8086

# Medicine Service (Port 8088): Pill reminders, Dose events, Adherence tracking
EXPO_PUBLIC_MEDICINE_URL=http://192.168.1.50:8088

# Calling Service (Port 8089): Twilio + Ultravox Interactive Voice AI Calls
EXPO_PUBLIC_CALLING_URL=http://192.168.1.50:8089
