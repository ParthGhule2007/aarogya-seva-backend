# ============================================================================
# Aarogya Seva SOS Emergency Alert Service - Environment Variables
# Copy to .env and configure for local or production deployment
# ============================================================================

# Service HTTP Configuration
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=dev

# Dedicated PostgreSQL Database Configuration (Do NOT share with core monolith)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aarogya_sos_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Notification Provider Mode: 'mock' (local dev/test) or 'fcm' (production Firebase)
SOS_NOTIFICATION_PROVIDER=mock

# Firebase Cloud Messaging Credentials (Required only when SOS_NOTIFICATION_PROVIDER=fcm)
# Option A: Direct Service Account JSON file path
FIREBASE_CREDENTIALS_PATH=
# Option B: Individual environment variables
FIREBASE_PROJECT_ID=aarogya-seva-emergency
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@aarogya-seva-emergency.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# External Service Integration Mode: 'mock' (standalone dev) or 'rest' (connected to core services)
SOS_CLIENTS_MODE=mock
PATIENT_SERVICE_URL=http://localhost:8081
FACILITY_SERVICE_URL=http://localhost:8081
LOCATION_SERVICE_URL=http://localhost:8081

# SOS Policy Configuration
SOS_NEARBY_RADIUS_KM=5.0
SOS_DEDUPLICATION_WINDOW_MINUTES=5
